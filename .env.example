# Application (client) ID of the multitenant Entra ID app registration (SPA platform).
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional: pre-fill the external tenant (domain or tenant ID) on the setup page.
VITE_DEFAULT_TENANT=

# Used by scripts/package.ps1 to build the Teams app package.
# Public HTTPS host (no scheme, optional path) where the built site is served, e.g. contoso.github.io/peek-a-boo
APP_HOST=localhost:5173
# Stable GUID for the Teams app (generate once with: [guid]::NewGuid()).
TEAMS_APP_ID=00000000-0000-0000-0000-000000000000
